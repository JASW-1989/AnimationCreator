{
  "name": "koma-studio",
  "version": "0.6.0-alpha",
  "private": true,
  "description": "Local-first, agent-operable 2D animation workbench. No runtime npm dependencies.",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/*.test.cjs",
    "build": "node tools/build.cjs",
    "test:integration": "node tests/integration_v050.cjs",
    "test:production": "node --test tests/production*.test.cjs",
    "test:browser": "python tests/browser_production.py",
    "test:pro": "node --test tests/pro.test.cjs tests/tracking-pro.test.cjs tests/batch-queue.test.cjs",
    "test:browser:pro": "python tests/browser_pro.py",
    "build:atelier": "node tools/build-atelier.cjs",
    "test:atelier": "node --test tests/atelier.test.cjs",
    "test:browser:atelier": "python tests/browser_atelier.py",
    "test:integration:atelier": "python tests/integration_atelier.py"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
